{
  "name": "ui5-next",
  "version": "0.1.0",
  "description": "Builds OpenUI5 into one tree of native ES modules (UI5 Next)",
  "type": "module",
  "bin": {
    "ui5-next": "bin/ui5-next.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node bin/ui5-next.mjs --from . --out dist --force",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-dist.mjs dist",
    "smoke": "node scripts/smoke.mjs demo/index.html && node scripts/smoke.mjs demo/xmlview.html",
    "import-all": "node scripts/import-all.mjs",
    "serve": "node scripts/serve.mjs . 8080"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "@openui5/sap.f": "1.154.0",
    "@openui5/sap.html": "1.154.0",
    "@openui5/sap.m": "1.154.0",
    "@openui5/sap.tnt": "1.154.0",
    "@openui5/sap.ui.codeeditor": "1.154.0",
    "@openui5/sap.ui.commons": "1.154.0",
    "@openui5/sap.ui.core": "1.154.0",
    "@openui5/sap.ui.documentation": "1.154.0",
    "@openui5/sap.ui.dt": "1.154.0",
    "@openui5/sap.ui.fl": "1.154.0",
    "@openui5/sap.ui.integration": "1.154.0",
    "@openui5/sap.ui.layout": "1.154.0",
    "@openui5/sap.ui.mdc": "1.154.0",
    "@openui5/sap.ui.rta": "1.154.0",
    "@openui5/sap.ui.suite": "1.154.0",
    "@openui5/sap.ui.support": "1.154.0",
    "@openui5/sap.ui.table": "1.154.0",
    "@openui5/sap.ui.testrecorder": "1.154.0",
    "@openui5/sap.ui.unified": "1.154.0",
    "@openui5/sap.ui.ux3": "1.154.0",
    "@openui5/sap.uxap": "1.154.0",
    "@openui5/themelib_sap_belize": "1.154.0",
    "@openui5/themelib_sap_bluecrystal": "1.154.0",
    "@openui5/themelib_sap_fiori_3": "1.154.0",
    "@openui5/themelib_sap_horizon": "1.154.0",
    "@openui5/ts-types": "1.154.0"
  },
  "license": "Apache-2.0"
}
