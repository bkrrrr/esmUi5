{
  "name": "esm-ui5",
  "version": "0.1.1",
  "description": "Builds OpenUI5 into one tree of native ES modules (esmUi5)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkrrrr/esmUi5"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/runtime/esm-ui5-runtime.js",
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node bin/esm-ui5.mjs all --clean",
    "build:esm": "node bin/esm-ui5.mjs esm --clean",
    "build:bundles": "node bin/esm-ui5.mjs bundle",
    "build:demo": "node bin/esm-ui5.mjs demo",
    "bundle:compare": "node scripts/bundle-compare.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "serve": "node bin/esm-ui5.mjs serve --out dist/demo",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-dist.mjs dist/esm",
    "check:build-report": "node scripts/check-build-report.mjs",
    "smoke": "node scripts/smoke.mjs test/browser/button.html && node scripts/smoke.mjs test/browser/xmlview.html && node scripts/smoke.mjs test/browser/bundles-import.html",
    "import-all": "node scripts/import-all.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@openui5/sap.f": "1.154.0",
    "@openui5/sap.html": "1.154.0",
    "@openui5/sap.m": "1.154.0",
    "@openui5/sap.tnt": "1.154.0",
    "@openui5/sap.ui.codeeditor": "1.154.0",
    "@openui5/sap.ui.commons": "1.154.0",
    "@openui5/sap.ui.core": "1.154.0",
    "@openui5/sap.ui.documentation": "1.154.0",
    "@openui5/sap.ui.dt": "1.154.0",
    "@openui5/sap.ui.fl": "1.154.0",
    "@openui5/sap.ui.integration": "1.154.0",
    "@openui5/sap.ui.layout": "1.154.0",
    "@openui5/sap.ui.mdc": "1.154.0",
    "@openui5/sap.ui.rta": "1.154.0",
    "@openui5/sap.ui.suite": "1.154.0",
    "@openui5/sap.ui.support": "1.154.0",
    "@openui5/sap.ui.table": "1.154.0",
    "@openui5/sap.ui.testrecorder": "1.154.0",
    "@openui5/sap.ui.unified": "1.154.0",
    "@openui5/sap.ui.ux3": "1.154.0",
    "@openui5/sap.uxap": "1.154.0",
    "@openui5/themelib_sap_belize": "1.154.0",
    "@openui5/themelib_sap_bluecrystal": "1.154.0",
    "@openui5/themelib_sap_fiori_3": "1.154.0",
    "@openui5/themelib_sap_horizon": "1.154.0",
    "@openui5/ts-types": "1.154.0",
    "acorn": "^8.14.0",
    "less-openui5": "0.12.0",
    "oxc-minify": "0.158.0",
    "rolldown": "1.3.2"
  },
  "license": "Apache-2.0"
}
